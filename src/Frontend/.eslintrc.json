{
  "root": true,
  "ignorePatterns": ["dist/", "node_modules/", "src/assets/**/*.min.js", "cypress.config.ts"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": ["tsconfig.app.json", "tsconfig.json"],
        "createDefaultProgram": true
      },
      "plugins": ["@typescript-eslint", "@angular-eslint", "prettier"],
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates",
        "plugin:@typescript-eslint/recommended",
        "plugin:prettier/recommended"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
        "prettier/prettier": [
          "error",
          { "singleQuote": true, "printWidth": 100, "trailingComma": "all", "endOfLine": "lf" }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {}
    }
  ]
}
